# Uses the WebKitGTK 4.1 build of OPTIC (Wails -tags webkit2_41), which the
# GNOME runtimes ship. Flathub may ask for a build from source instead.
app-id: {{.AppID}}
runtime: org.gnome.Platform
runtime-version: '50'
sdk: org.gnome.Sdk
command: optic-desktop
finish-args:
  - --share=network
  - --share=ipc
  - --socket=wayland
  - --socket=fallback-x11
  - --device=dri
modules:
  - name: optic
    buildsystem: simple
    build-commands:
      - install -Dm755 optic-desktop /app/bin/optic-desktop
      - install -Dm644 optic-512.png /app/share/icons/hicolor/512x512/apps/{{.AppID}}.png
      - sed 's/^Icon=.*/Icon={{.AppID}}/' optic.desktop > {{.AppID}}.desktop
      - install -Dm644 {{.AppID}}.desktop /app/share/applications/{{.AppID}}.desktop
      - install -Dm644 {{.AppID}}.metainfo.xml /app/share/metainfo/{{.AppID}}.metainfo.xml
    sources:
      - type: archive
        url: {{.Tarball41.URL}}
        sha256: {{.Tarball41.SHA256}}
        strip-components: 1
      - type: file
        path: {{.AppID}}.metainfo.xml
